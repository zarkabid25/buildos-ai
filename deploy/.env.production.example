# Copy to deploy/.env.production (never commit the real file) and fill in.
# The backend refuses to start in production if these are left at unsafe values.

POSTGRES_USER=buildos
# Long and random, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=buildos

# At least 32 random characters. Changing it signs everyone out.
JWT_SECRET_KEY=

# Where browsers reach the app and the API (behind your TLS proxy).
CORS_ORIGINS=["https://app.example.com"]
PUBLIC_API_URL=https://api.example.com/api/v1
# Address of the reverse proxy, so login rate limits see real client IPs.
FORWARDED_ALLOW_IPS=127.0.0.1
# The real host(s) your API is served as -- the backend refuses to start in
# production without this (Phase 9.1, Task 2). Comma-separated or JSON list.
TRUSTED_HOSTS=api.example.com

# REQUIRED in staging/production as of Phase 10 (Task 1): the backend refuses
# to start if this isn't reachable -- rate limiting and session revocation
# would otherwise silently run in single-process-only mode. The bundled
# `redis` service in docker-compose.prod.yml already satisfies this; only
# change this if pointing at a different/managed Redis.
REDIS_URL=redis://redis:6379/0

# Explicit, closed set: "development" | "test" | "staging" | "production".
# Anything else is rejected at startup rather than silently skipping the
# checks below. Staging is held to the exact same checks as production.
ENVIRONMENT=production

# Optional: switches on the AI assistant.
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LOG_LEVEL=INFO

# REQUIRED in staging/production as of Phase 10 (Task 2): "console" (the
# sandbox used in development/test) is refused outside development/test, so
# a real provider must be configured here. Set EMAIL_PROVIDER=smtp plus the
# SMTP_* values below for a real send; without SMTP_HOST, the backend will
# refuse to start once EMAIL_PROVIDER isn't "console".
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@example.com
APP_BASE_URL=https://app.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional (Phase 10, Task 3): "local" (default -- the only backend this
# project has ever actually run against; files persist in the `uploads`
# Docker volume) or "s3" for S3-compatible object storage. Deliberately not
# required -- unlike Redis/email, nothing mandates object storage, so a
# staging/production deploy can still legitimately run with local storage
# until real S3-compatible credentials are approved and provisioned.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
